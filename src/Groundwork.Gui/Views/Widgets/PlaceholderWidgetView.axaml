<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Groundwork.Gui.ViewModels.Widgets"
             x:Class="Groundwork.Gui.Views.Widgets.PlaceholderWidgetView"
             x:DataType="vm:PlaceholderWidgetViewModel">

    <Border BorderBrush="{StaticResource GwBorderBrush}"
            BorderThickness="1"
            CornerRadius="2"
            Margin="1">
        <TextBlock Text="{Binding Label}"
                   Foreground="{StaticResource GwTextDimBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14" />
    </Border>

</UserControl>
