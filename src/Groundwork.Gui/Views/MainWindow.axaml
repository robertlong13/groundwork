<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Groundwork.Gui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Groundwork.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Groundwork"
        Icon="/Assets/groundwork.ico"
        Background="{StaticResource GwBaseBrush}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="32"
        Width="1280" Height="720">

    <DockPanel>

        <!-- Title bar spacer (content extends into system title bar) -->
        <Border DockPanel.Dock="Top"
                Height="32"
                IsHitTestVisible="False" />

        <!-- Icon rail (left) -->
        <Border DockPanel.Dock="Left"
                Background="{StaticResource GwSurfaceBrush}"
                BorderBrush="{StaticResource GwBorderBrush}"
                BorderThickness="0,0,1,0"
                Width="48">
            <ListBox ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding CurrentPage}"
                     Background="Transparent"
                     Padding="0"
                     Margin="0,4">

                <ListBox.Styles>
                    <!-- Strip default ListBoxItem chrome -->
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>

                    <!-- Hover: subtle raise -->
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{StaticResource GwRailHoverBrush}" />
                    </Style>

                    <!-- Selected: brighter background + left accent bar -->
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{StaticResource GwRailSelectedBrush}" />
                    </Style>

                    <!-- Icon color: dim normally, brighter on hover, accent when selected -->
                    <Style Selector="ListBoxItem PathIcon">
                        <Setter Property="Foreground" Value="{StaticResource GwTextDimBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover PathIcon">
                        <Setter Property="Foreground" Value="{StaticResource GwTextBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected PathIcon">
                        <Setter Property="Foreground" Value="{StaticResource GwAccentBrightBrush}" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageViewModelBase">
                        <Panel>
                            <!-- Left accent bar (visible when selected) -->
                            <Border HorizontalAlignment="Left"
                                    Width="3" Height="20"
                                    CornerRadius="0,2,2,0"
                                    Margin="-20,0,0,0"
                                    Background="{StaticResource GwAccentBrush}"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                            <PathIcon Data="{Binding IconPathData}"
                                      Width="20" Height="20"
                                      ToolTip.Tip="{Binding Title}" />
                        </Panel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Border>

        <!-- View content area (fills remainder) -->
        <ContentControl Content="{Binding CurrentPage}" />

    </DockPanel>

</Window>
